# A 线此前完全没有 .env.example，变量名只能从代码反推。以下即全量清单。
# LLM_BASE_URL 只能填「不含路径」的基地址：代码会自行追加 /v1/messages，
# 填成完整端点会得到 .../v1/messages/v1/messages。

# ---- LLM（Anthropic Messages 协议；网关可换）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_KEY=
# service_role key，仅服务端；可绕过 RLS，勿下发前端
SUPABASE_SERVICE_KEY=

# ---- 前端 ----
# 同源部署留空即可
NEXT_PUBLIC_API_URL=
